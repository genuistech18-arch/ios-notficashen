NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=notification_app
DB_PASSWORD=notification_app
DB_NAME=notification_app

# Static API key required in the `x-api-key` header for POST /api/v1/notifications/send
API_SEND_KEY=change-me-to-a-long-random-string

# Path (relative to backend/) to the Firebase service account JSON downloaded from
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

REGISTER_THROTTLE_TTL_MS=60000
REGISTER_THROTTLE_LIMIT=5
